EXEC=btree_concurrent_mixed
OUTPUT_FILE=output.txt
POOL_PATH=/mnt/pmfs/pool6
THREADS=$(shell seq 2 2 32)

all: clean run clean_bc

run:
	@for t in $(THREADS); do \
		echo "Running with -t $$t"; \
		sudo rm -f $(POOL_PATH); \
		sudo ./$(EXEC) -n 50 -i input.txt -t $$t -p $(POOL_PATH); \
		mv $(OUTPUT_FILE) fastFair_$$t.txt; \
	done

clean_bc:
	rm -f *.bc *.ll a.out

clean:
	rm -f $(OUTPUT_FILE) output_*.txt
	sudo rm -f $(POOL_PATH)

.PHONY: all clean run clean_bc