experimentDirectory = experiments
.PHONY: fastFair CCEH all

all: fastFair CCEH

# Step 1: Run the commands in the fastFair directory
fastFair:
	cd $(experimentDirectory)/fastFair && sh commands.sh

# Step 2: Run the commands in the CCEH directory with sudo
CCEH:
	cd $(experimentDirectory)/CCEH && sudo sh commands.sh
