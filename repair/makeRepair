l1 = list motivatingExample stack

process_files:
	rm -f ../benchmark/bcFiles/results/*.txt
	$(foreach file_name,$(l1), \
	echo "Repairing program in $(file_name)"; \
	python3 trace_formatter.py ../benchmark/bcFiles/outputs/$(file_name)_output.txt ../benchmark/bcFiles/outputs/$(file_name)_formatted_output.txt; \
	python3 step1.py ../benchmark/bcFiles/outputs/$(file_name)_formatted_output.txt ../benchmark/bcFiles/results/$(file_name)_trace_r1.txt>> ../benchmark/bcFiles/results/$(file_name)_r1.txt; \
	echo "Repair of $(file_name) completed."; \
	)

.PHONY: process_files
