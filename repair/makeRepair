# l1 = list motivatingExample stack queue queue_1 queue_2
FOLDER = ../ThreadTrove
l1 = Clevel_hashing memcached P-CLHT CCEH fastFair $(shell find $(FOLDER) -maxdepth 1 -type d | sed 's|.*/||' | tail -n +2) 
# l1 = graph
# l1 = set stack_1 array stack queue_2
process_files:
	@echo "Subfolders: $(l1)"
	rm -f ../repair/Report.txt
	rm -f ../results/results/*.txt
	rm -f ../results/repairedFiles/*.txt
	$(foreach file_name,$(l1), \
	echo "\n"; \
	echo "Repairing program in $(file_name)"; \
	python3 trace_formatter.py ../results/outputs/$(file_name)_output.txt ../results/outputs/$(file_name)_formatted_output.txt; \
	python3 step1.py ../results/outputs/$(file_name)_formatted_output.txt ../results/results/$(file_name)_trace_repaired.txt $(file_name) >> ../results/results/$(file_name)_r1.txt; \
	python3 step4.py ../results/results/$(file_name)_trace_repaired.txt ../results/repairedFiles/$(file_name)_trace_last_repair.txt $(file_name)>> ../results/results/$(file_name)_r2.txt ; \
	echo "Repair of $(file_name) completed."; \
	)

.PHONY: process_files
