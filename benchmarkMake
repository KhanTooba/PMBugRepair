# Compiler and Flags
CC = clang
CFLAGS = -g -emit-llvm -c
PMInvGen_dir = ./build/Transform/

INCLUDE_GEN = ./Transform/PM/

# l1 = list motivatingExample stack queue queue_1 queue_2

FOLDER = ThreadTrove
l1 = $(shell find $(FOLDER) -maxdepth 1 -type d | sed 's|.*/||' | tail -n +2)


all: compile_and_opt

compile_and_opt:
	$(foreach file,$(l1), \
		echo "Processing $(file)"; \
		$(CC) $(CFLAGS) ThreadTrove/$(file)/$(file).c -o results/bcFiles/$(file).bc -I ThreadTrove/$(file) -I $(INCLUDE_GEN); \
		opt -load $(PMInvGen_dir)/PMTraceGen/libLLVMPMTraceGen.so --pmtracegen results/bcFiles/$(file).bc -o results/bcFiles/$(file)_tracegen.bc; \
		$(CC) -g results/bcFiles/$(file)_tracegen.bc -o results/bcFiles/$(file)_exec.o -pthread -L/usr/lib/x86_64-linux-gnu -lm -L$(PMInvGen_dir)/PM -Wl,-rpath=$(PMInvGen_dir)/PM -lLLVMPMC ; \
		./results/bcFiles/$(file)_exec.o; \
		mv output.txt ./results/outputs/$(file)_output.txt; \
		echo "Processed $(file)"; \
	)

# Clean up
clean:
	rm -f $(BC_FILES)
#all: $(BC_FILES)

#Phony targets
.PHONY: all clean
